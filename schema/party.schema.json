{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spec": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "position": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Equipped abilities, in order."
          },
          "gear": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Slot id to gear id."
          }
        },
        "required": [
          "spec",
          "position",
          "abilities",
          "gear"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formation",
    "units"
  ],
  "additionalProperties": false
}
