{
  // Game logic that will move into Memory's Worker or browser bundle.
  // No Node types here, so a Node-only API (fs, process, Buffer) fails the
  // typecheck. Add the engine's folder when step 2 creates it. Tests run in
  // Node and are checked by tsconfig.json instead.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/schema.ts", "src/validate.ts", "src/engine"],
  "exclude": ["**/*.test.ts"]
}
