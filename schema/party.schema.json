{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "units": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "position": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Equipped abilities, in slot order: a class ability, or (step 5i) the trained form of one (<id>__p, __a, __b, __ap or __bp)."
          },
          "passive": {
            "description": "Step 5i: the trained form of its class passive (<passive>__p, __a, __b, __ap or __bp): a status that takes the passive status's place at fight start and on a revive. Absent: the class's own.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "gear": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Slot (weapon, armor, offhand, amulet) to gear id."
          }
        },
        "required": [
          "class",
          "position",
          "abilities",
          "gear"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formation",
    "units"
  ],
  "additionalProperties": false
}
