{
  "name": "dungeon-content",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "validate": "tsx tools/validate-pack.ts content/core-set.pack.json && tsx tools/validate-pack.ts fixtures/hollow.pack.json",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.core.json && tsc -p ui",
    "build:schema": "tsx tools/export-json-schema.ts",
    "docs": "tsx tools/primitives-doc.ts > PRIMITIVES.md",
    "examples": "tsx tools/extract-examples.ts",
    "dungeon": "tsx tools/dungeon.ts",
    "study": "esbuild tools/study.ts --bundle --platform=node --format=esm --outfile=out/study.mjs --log-level=warning && node out/study.mjs",
    "content": "tsx content/core-set/build.ts",
    "smoke": "tsx tools/smoke.ts",
    "ui": "vite ui",
    "ui:build": "vite build ui",
    "rogue": "esbuild tools/rogue-sim.ts --bundle --platform=node --format=esm --outfile=out/rogue.mjs --log-level=warning && node out/rogue.mjs",
    "rogue:calibrate": "esbuild tools/rogue-calibrate.ts --bundle --platform=node --format=esm --outfile=out/rogue-calibrate.mjs --log-level=warning && node out/rogue-calibrate.mjs",
    "rogue:tune": "esbuild tools/rogue-tune.ts --bundle --platform=node --format=esm --outfile=out/rogue-tune.mjs --log-level=warning && node out/rogue-tune.mjs",
    "rogue:legendaries": "esbuild tools/rogue-legendaries.ts --bundle --platform=node --format=esm --outfile=out/rogue-legendaries.mjs --log-level=warning && node out/rogue-legendaries.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --format=esm --outfile=out/balance.mjs --log-level=warning && node out/balance.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
