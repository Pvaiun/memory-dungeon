{
  "schemaVersion": "0.3",
  "id": "worked_example",
  "title": "Placeholder fixture: Hollow of the Grey Mother",
  "note": "PLACEHOLDER. Not game design. This pack exists to prove the schema can express the game's rules, to give the tests something to break, and to be the first input for the step 2 engine. Every class, number, name and enemy here is disposable; real content comes from steps 12 to 15.",

  "design": {
    "note": "Placeholder targets taken from the concept spec, which was bullish on them. Expect every number here to change.",
    "formationPositions": 5,
    "partySize": [1, 5],
    "abilitiesPerSpec": 4,
    "abilitiesEquipped": 2,
    "perkPicksPerRun": [3, 4],
    "perkPoolSize": [10, 15],
    "perkOptionsPerPick": 3,
    "keyholesPerBoss": [2, 4],
    "rules": { "abilitiesAreBehaviour": true, "efficacyGearSimple": true },
    "complete": { "classes": [8, 10], "specsPerClass": [3, 4], "verbs": [15, 20], "maxStatusShare": 0.2 }
  },

  "ruleset": {
    "turnOrder": { "kind": "by_stat", "stat": "speed", "ties": "random" },
    "actionsPerTurn": 1,
    "defaultModes": [{ "use": "ability" }, { "use": "basic" }],
    "defaultBehaviour": "standard",
    "maxRounds": 30,
    "onTimeout": "loss",
    "defeat": { "stat": "hp", "atOrBelow": 0 },
    "damagePipeline": ["hit", "crit", "block", "scale", "mitigate", "floor"],
    "formulas": {
      "hitChance": { "clamp": [{ "sub": [{ "stat": "accuracy", "of": "attacker" }, { "stat": "evasion", "of": "defender" }] }, 0.05, 0.95] },
      "critChance": { "stat": "crit_chance", "of": "attacker" },
      "critMultiplier": { "stat": "crit_mult", "of": "attacker" },
      "blockChance": { "stat": "block_chance", "of": "defender" },
      "blockMultiplier": { "sub": [1, { "stat": "block_power", "of": "defender" }] },
      "damageScale": { "mul": [{ "stat": "damage_dealt", "of": "attacker" }, { "stat": "damage_taken", "of": "defender" }] },
      "minDamage": 1
    },
    "modifierStacking": "add_then_multiply",
    "targeting": { "weightStat": "aggro" },
    "maxEnemies": 6,
    "run": {
      "betweenFights": [
        { "op": "heal", "amount": { "mul": [0.15, { "stat": "max_hp", "of": "self" }] }, "target": { "from": "self" } }
      ],
      "defeatedUnits": "stay_down",
      "statusesClearAtFightEnd": true,
      "cooldownsResetEachFight": true,
      "perkOffer": { "options": 3, "premiumChance": 0.08, "repeatPicked": false, "offerInapplicable": true }
    }
  },

  "stats": [
    { "id": "max_hp", "name": "Max HP", "kind": "attribute", "default": 100, "min": 1 },
    { "id": "hp", "name": "HP", "kind": "resource", "default": 0, "min": 0, "maxStat": "max_hp", "persistence": "run", "note": "Carries across the run: the main resource that wears down." },
    { "id": "attack", "name": "Attack", "kind": "attribute", "default": 10, "min": 0 },
    { "id": "magic", "name": "Magic", "kind": "attribute", "default": 0, "min": 0 },
    { "id": "defence", "name": "Defence", "kind": "attribute", "default": 0, "min": 0, "note": "Subtracted from each physical hit (see damageTypes), so it punishes many small hits." },
    { "id": "resistance", "name": "Resistance", "kind": "attribute", "default": 0, "min": 0 },
    { "id": "speed", "name": "Speed", "kind": "attribute", "default": 10, "min": 0 },
    { "id": "accuracy", "name": "Accuracy", "kind": "attribute", "default": 0.9, "min": 0 },
    { "id": "evasion", "name": "Evasion", "kind": "attribute", "default": 0.05, "min": 0, "max": 0.6 },
    { "id": "crit_chance", "name": "Crit chance", "kind": "attribute", "default": 0.05, "min": 0, "max": 1 },
    { "id": "crit_mult", "name": "Crit damage", "kind": "attribute", "default": 1.5, "min": 1 },
    { "id": "block_chance", "name": "Block chance", "kind": "attribute", "default": 0, "min": 0, "max": 0.75 },
    { "id": "block_power", "name": "Block strength", "kind": "attribute", "default": 0.5, "min": 0, "max": 1 },
    { "id": "aggro", "name": "Aggro", "kind": "attribute", "default": 1, "min": 0, "note": "How likely enemies are to pick this unit. Formation slots and taunts change it." },
    { "id": "damage_dealt", "name": "Damage dealt", "kind": "attribute", "default": 1, "min": 0, "note": "Multiplier on damage this unit deals, applied before armour, so big multipliers beat defence." },
    { "id": "damage_taken", "name": "Damage taken", "kind": "attribute", "default": 1, "min": 0, "note": "Multiplier on damage this unit takes." }
  ],

  "damageTypes": [
    { "id": "physical", "name": "Physical", "mitigation": { "max": [{ "sub": [{ "var": "raw" }, { "stat": "defence", "of": "defender" }] }, { "mul": [0.25, { "var": "raw" }] }] } },
    { "id": "magic", "name": "Magic", "mitigation": { "max": [{ "sub": [{ "var": "raw" }, { "stat": "resistance", "of": "defender" }] }, { "mul": [0.25, { "var": "raw" }] }] } },
    { "id": "pure", "name": "Pure", "mitigation": { "var": "raw" } }
  ],

  "statuses": [
    {
      "id": "bleed", "name": "BLEED", "text": "Loses health at the end of each turn. Stacks.", "on": "others",
      "stacking": "stack", "maxStacks": 5, "defaultTurns": 3,
      "rules": [
        { "id": "tick", "kind": "triggered", "when": { "on": "turn_end" },
          "do": [{ "op": "damage", "type": "pure", "amount": { "mul": [4, { "stacks": "bleed", "of": "self" }] }, "target": { "from": "self" }, "hit": { "canMiss": false, "canCrit": false, "canBlock": false } }] }
      ],
      "note": "Rangers' niche. Shared by anyone who applies it: cross-pollination is accepted and balanced by roster design."
    },
    {
      "id": "rot", "name": "ROT", "text": "Loses health at the end of each turn.", "on": "others",
      "stacking": "refresh", "defaultTurns": 3,
      "rules": [
        { "id": "tick", "kind": "triggered", "when": { "on": "turn_end" },
          "do": [{ "op": "damage", "type": "magic", "amount": 5, "target": { "from": "self" }, "hit": { "canMiss": false, "canCrit": false, "canBlock": false } }] }
      ]
    },
    { "id": "stunned", "name": "STUNNED", "text": "Loses its next turn.", "on": "others", "flags": ["skip_turn"], "stacking": "refresh", "defaultTurns": 1 },
    { "id": "taunting", "name": "TAUNTING", "text": "Drawing the enemy's attention.", "on": "self", "stacking": "refresh", "defaultTurns": 2,
      "rules": [{ "id": "draw", "kind": "passive", "do": [{ "op": "stat", "stat": "aggro", "mode": "mul", "value": 5 }] }] },
    { "id": "guarding", "name": "GUARD", "text": "Braced: takes less damage until its next turn ends.", "on": "self", "stacking": "refresh", "defaultTurns": 1,
      "rules": [{ "id": "brace", "kind": "passive", "do": [{ "op": "stat", "stat": "damage_taken", "mode": "mul", "value": 0.6 }] }],
      "note": "SaGa's auto-defend, applied by formation slots at the end of the unit's turn." },
    {
      "id": "lethality", "name": "LETHALITY", "text": "Each stack sharpens critical hits. Lunge spends them all.", "on": "self",
      "stacking": "stack", "maxStacks": 5,
      "rules": [{ "id": "sharpen", "kind": "passive", "do": [{ "op": "stat", "stat": "crit_chance", "mode": "add", "value": { "mul": [0.03, { "stacks": "lethality", "of": "self" }] } }] }],
      "note": "The self-stacking pattern: the unit builds stacks on itself and spends them, so no other unit can double-dip."
    },
    {
      "id": "frenzied", "name": "FRENZIED", "text": "Hurt, angry and faster for it.", "on": "self",
      "stacking": "refresh",
      "rules": [{ "id": "rage", "kind": "passive", "do": [{ "op": "stat", "stat": "attack", "mode": "mul", "value": 1.3 }, { "op": "stat", "stat": "speed", "mode": "add", "value": 4 }] }],
      "note": "Also a behaviour state: the Grey Mother's behaviour reads it."
    },
    {
      "id": "rhythm", "name": "RHYTHM", "text": "Each stack sharpens critical hits a little.", "on": "self",
      "stacking": "stack", "maxStacks": 5,
      "rules": [{ "id": "flow", "kind": "passive", "do": [{ "op": "stat", "stat": "crit_chance", "mode": "add", "value": { "mul": [0.02, { "stacks": "rhythm", "of": "self" }] } }] }]
    }
  ],

  "verbs": [
    { "id": "physical_damage", "name": "Physical damage", "note": "Deals physical damage, or raises attack.", "signals": [{ "op": "damage", "damageType": "physical" }, { "stat": "attack", "sign": "positive" }] },
    { "id": "magic_damage", "name": "Magic damage", "note": "Deals magic damage, or raises magic.", "signals": [{ "op": "damage", "damageType": "magic" }, { "stat": "magic", "sign": "positive" }] },
    { "id": "damage_over_time", "name": "Damage over time", "note": "Applies a status that deals damage on turn_start or turn_end.", "signals": [{ "statusTicks": true }] },
    { "id": "burst", "name": "Burst", "note": "Raises crit chance, crit damage or damage dealt, or multiplies an action's amount above 1.", "signals": [{ "stat": "crit_chance", "sign": "positive" }, { "stat": "crit_mult", "sign": "positive" }, { "stat": "damage_dealt", "sign": "positive" }, { "amountUp": true }] },
    { "id": "multi_hit", "name": "Multi-hit", "note": "An action that hits more than once per use.", "signals": [{ "multiHit": true }] },
    { "id": "area", "name": "Area", "note": "Splashes onto the target's allies, or hits every enemy at once.", "signals": [{ "from": "action_target_allies" }, { "from": "event_target_allies" }, { "from": "enemies", "pick": "all" }] },
    { "id": "initiative", "name": "Initiative", "note": "Acts earlier: the acts_first flag, or more speed.", "signals": [{ "flag": "acts_first" }, { "stat": "speed", "sign": "positive" }] },
    { "id": "counter", "name": "Counter", "note": "Acts back at, or damages, whoever caused an event.", "signals": [{ "performs": "counter" }, { "op": "damage", "from": "event_source" }] },
    { "id": "extra_action", "name": "Extra action", "note": "Takes an action outside its turn without targeting the event's source.", "signals": [{ "performs": "extra" }] },
    { "id": "control", "name": "Control", "note": "Applies a status that costs the target its turn.", "signals": [{ "statusFlag": "skip_turn" }] },
    { "id": "evasion", "name": "Evasion", "note": "High base evasion, or raises evasion.", "signals": [{ "stat": "evasion", "sign": "positive" }, { "statAtLeast": { "stat": "evasion", "value": 0.2 } }] },
    { "id": "blocking", "name": "Blocking", "note": "High base block chance, or raises it.", "signals": [{ "stat": "block_chance", "sign": "positive" }, { "statAtLeast": { "stat": "block_chance", "value": 0.2 } }] },
    { "id": "armour", "name": "Armour", "note": "High base defence, raises defence, or lowers damage taken.", "signals": [{ "stat": "defence", "sign": "positive" }, { "statAtLeast": { "stat": "defence", "value": 10 } }, { "stat": "damage_taken", "sign": "negative" }] },
    { "id": "healing", "name": "Healing", "note": "Restores HP.", "signals": [{ "op": "heal" }] },
    { "id": "protect", "name": "Protect", "note": "Draws enemy attacks away from allies: raises aggro, or has high base aggro.", "signals": [{ "stat": "aggro", "sign": "positive" }, { "statAtLeast": { "stat": "aggro", "value": 2 } }] },
    { "id": "numbers", "name": "Numbers", "note": "Gets stronger depending on how many allies are alive.", "signals": [{ "conditionAlive": true }] },
    { "id": "summon", "name": "Summon", "note": "Adds units to its side mid-fight.", "signals": [{ "op": "summon" }] },
    { "id": "cleanse", "name": "Cleanse", "note": "Removes statuses from a target or an ally.", "signals": [{ "op": "remove_status", "from": "action_target" }, { "op": "remove_status", "from": "allies" }, { "op": "remove_status", "from": "allies_and_self" }] },
    { "id": "execute", "name": "Execute", "note": "Picks the weakest enemy.", "signals": [{ "from": "enemies", "pick": "lowest" }] }
  ],

  "traits": [
    { "id": "agile", "word": "agile", "verbs": ["evasion"] },
    { "id": "strong_in_numbers", "word": "strong in numbers", "verbs": ["numbers"] },
    { "id": "festering", "word": "festering", "forms": ["festers"], "verbs": ["damage_over_time"] },
    { "id": "thick_hided", "word": "thick-hided", "verbs": ["armour"] },
    { "id": "strikes_many_times", "word": "strikes many times a turn", "verbs": ["multi_hit"] },
    { "id": "calls_for_help", "word": "calls for help", "verbs": ["summon"] }
  ],

  "slots": [
    { "id": "warrior_weapon", "name": "Blade", "class": "warrior" },
    { "id": "ranger_weapon", "name": "Ranger's weapon", "class": "ranger" },
    { "id": "cleric_focus", "name": "Focus", "class": "cleric" },
    { "id": "armour", "name": "Armour" },
    { "id": "charm", "name": "Charm" }
  ],

  "actions": [
    { "id": "slash", "name": "Slash",
      "do": [{ "op": "damage", "type": "physical", "amount": { "stat": "attack", "of": "self" }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage"] },
    { "id": "thrust", "name": "Thrust",
      "do": [{ "op": "damage", "type": "physical", "amount": { "stat": "attack", "of": "self" }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage"] },
    { "id": "shoot", "name": "Shoot",
      "do": [{ "op": "damage", "type": "physical", "amount": { "stat": "attack", "of": "self" }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage"] },
    { "id": "smite", "name": "Smite",
      "do": [{ "op": "damage", "type": "magic", "amount": { "stat": "magic", "of": "self" }, "target": { "from": "action_target" } }],
      "verbs": ["magic_damage"] },
    { "id": "bite", "name": "Bite",
      "do": [{ "op": "damage", "type": "physical", "amount": { "stat": "attack", "of": "self" }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage"] },
    { "id": "grave_rot", "name": "Grave Rot",
      "do": [
        { "op": "damage", "type": "magic", "amount": { "stat": "magic", "of": "self" }, "target": { "from": "action_target" } },
        { "op": "apply_status", "status": "rot", "target": { "from": "action_target" } }
      ],
      "verbs": ["magic_damage", "damage_over_time"] },
    { "id": "rend", "name": "Rend", "hits": 3,
      "do": [{ "op": "damage", "type": "physical", "amount": { "mul": [0.45, { "stat": "attack", "of": "self" }] }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage", "multi_hit"] },

    { "id": "shield_bash", "name": "Shield Bash",
      "target": { "from": "enemies", "pick": "weighted", "count": 1 },
      "do": [
        { "op": "damage", "type": "physical", "amount": { "mul": [0.6, { "stat": "attack", "of": "self" }] }, "target": { "from": "action_target" } },
        { "op": "apply_status", "status": "stunned", "target": { "from": "action_target" }, "turns": 1 }
      ],
      "verbs": ["physical_damage", "control"] },
    { "id": "volley", "name": "Volley",
      "target": { "from": "enemies", "pick": "all" },
      "do": [{ "op": "damage", "type": "physical", "amount": { "mul": [0.5, { "stat": "attack", "of": "self" }] }, "target": { "from": "action_target" } }],
      "verbs": ["physical_damage", "area"] },
    { "id": "lunge", "name": "Lunge",
      "target": { "from": "enemies", "pick": "lowest", "by": { "div": [{ "stat": "hp", "of": "candidate" }, { "stat": "max_hp", "of": "candidate" }] }, "count": 1 },
      "do": [
        { "op": "damage", "type": "physical",
          "amount": { "mul": [{ "stat": "attack", "of": "self" }, { "add": [1, { "mul": [0.5, { "stacks": "lethality", "of": "self" }] }] }] },
          "target": { "from": "action_target" } },
        { "op": "remove_status", "status": "lethality", "target": { "from": "self" } }
      ],
      "verbs": ["physical_damage", "execute"] },
    { "id": "mend", "name": "Mend",
      "target": { "from": "allies_and_self", "where": { "hpBelow": 0.6, "of": "candidate" }, "pick": "lowest", "by": { "div": [{ "stat": "hp", "of": "candidate" }, { "stat": "max_hp", "of": "candidate" }] }, "count": 1 },
      "do": [{ "op": "heal", "amount": { "mul": [0.9, { "stat": "magic", "of": "self" }] }, "target": { "from": "action_target" } }],
      "verbs": ["healing"] },
    { "id": "purify", "name": "Purify",
      "target": { "from": "allies_and_self", "where": { "any": [{ "hasStatus": "rot", "of": "candidate" }, { "hasStatus": "bleed", "of": "candidate" }] }, "pick": "random", "count": 1 },
      "do": [
        { "op": "remove_status", "status": "rot", "target": { "from": "action_target" } },
        { "op": "remove_status", "status": "bleed", "target": { "from": "action_target" } }
      ],
      "verbs": ["cleanse"] },
    { "id": "blessed_ward", "name": "Blessed Ward",
      "target": { "from": "allies_and_self", "where": { "hpBelow": 0.5, "of": "candidate" }, "pick": "lowest", "by": { "div": [{ "stat": "hp", "of": "candidate" }, { "stat": "max_hp", "of": "candidate" }] }, "count": 1 },
      "do": [{ "op": "buff", "stat": "defence", "mode": "add", "value": 5, "target": { "from": "action_target" }, "turns": 2 }],
      "verbs": ["armour"] },
    { "id": "radiance", "name": "Radiance",
      "target": { "from": "enemies", "pick": "all" },
      "do": [{ "op": "damage", "type": "magic", "amount": { "mul": [0.6, { "stat": "magic", "of": "self" }] }, "target": { "from": "action_target" } }],
      "verbs": ["magic_damage", "area"] },
    { "id": "howl", "name": "Howl",
      "target": { "from": "self" },
      "do": [{ "op": "summon", "enemy": "ash_wolf", "count": 2 }],
      "verbs": ["summon"] },
    { "id": "sound_the_horn", "name": "Sound the Horn",
      "target": { "from": "allies_and_self", "pick": "all" },
      "do": [{ "op": "buff", "stat": "attack", "mode": "mul", "value": 1.2, "target": { "from": "action_target" }, "turns": 2 }],
      "verbs": ["physical_damage"] }
  ],

  "behaviours": [
    { "id": "standard", "note": "The default for almost everyone: attack an enemy picked by aggro, which is random unless something draws attention.",
      "basicTarget": { "from": "enemies", "pick": "weighted", "count": 1 } },
    { "id": "finisher", "note": "Finishes off the most wounded enemy.",
      "basicTarget": { "from": "enemies", "pick": "lowest", "by": { "div": [{ "stat": "hp", "of": "candidate" }, { "stat": "max_hp", "of": "candidate" }] }, "count": 1 } },
    { "id": "grey_mother", "note": "Calls the pack while calm. Once frenzied, she stops calling and only rends.",
      "basicTarget": { "from": "enemies", "pick": "weighted", "count": 1 },
      "modes": [
        { "when": { "hasStatus": "frenzied" }, "use": "basic" },
        { "use": "ability" },
        { "use": "basic" }
      ] }
  ],

  "classes": [
    { "id": "warrior", "name": "Warrior", "text": "Front-line fighters who hold the line.",
      "slots": ["warrior_weapon"],
      "stats": { "max_hp": 120, "attack": 14, "defence": 6, "resistance": 2, "speed": 8, "accuracy": 0.9, "evasion": 0.05, "crit_chance": 0.05, "block_chance": 0.25, "block_power": 0.5 } },
    { "id": "ranger", "name": "Ranger", "text": "Quick, sharp-eyed skirmishers.",
      "slots": ["ranger_weapon"],
      "stats": { "max_hp": 85, "attack": 15, "defence": 3, "resistance": 3, "speed": 14, "accuracy": 0.95, "evasion": 0.15, "crit_chance": 0.12, "crit_mult": 1.75 } },
    { "id": "cleric", "name": "Cleric", "text": "Keepers of the old rites, who keep everyone standing.",
      "slots": ["cleric_focus"],
      "stats": { "max_hp": 90, "attack": 4, "magic": 13, "defence": 3, "resistance": 8, "speed": 9 } }
  ],

  "specializations": [
    { "id": "warrior_vanguard", "class": "warrior", "name": "Warrior: Vanguard",
      "text": "Holds the front, cleaves through crowds, and steps in when friends falter.",
      "source": "starter", "basicAction": "slash",
      "abilities": ["cleave", "stand_guard", "shield_bash", "second_wind"],
      "verbs": ["physical_damage", "area", "protect", "control", "healing", "blocking"] },
    { "id": "ranger_archer", "class": "ranger", "name": "Ranger: Archer",
      "text": "Shoots fast, bleeds what it hits, and covers friends in trouble.",
      "source": "unlock", "basicAction": "shoot",
      "abilities": ["barbed_arrows", "volley", "quick_draw", "covering_fire"],
      "verbs": ["physical_damage", "damage_over_time", "area", "initiative", "counter"] },
    { "id": "ranger_duelist", "class": "ranger", "name": "Ranger: Duelist",
      "text": "Fights up close, slips every blow, and saves it all for one decisive lunge.",
      "source": "unlock", "stats": { "max_hp": 80, "speed": 16, "evasion": 0.25 },
      "basicAction": "thrust", "behaviour": "finisher",
      "abilities": ["riposte", "flurry", "read_the_blade", "lunge"],
      "verbs": ["physical_damage", "execute", "counter", "multi_hit", "evasion", "burst"] },
    { "id": "cleric_mender", "class": "cleric", "name": "Cleric: Mender",
      "text": "Mends wounds, lifts curses, and smites when nobody needs her.",
      "source": "unlock", "basicAction": "smite",
      "abilities": ["mend", "purify", "blessed_ward", "radiance"],
      "verbs": ["magic_damage", "healing", "cleanse", "armour", "area"] }
  ],

  "abilities": [
    { "id": "cleave", "class": "warrior", "name": "Cleave", "text": "Basic attacks also hit one other enemy for half damage.",
      "rules": [{ "id": "splash", "kind": "passive", "do": [{ "op": "modify_action", "action": "basic",
        "addEffects": [{ "op": "damage", "type": "physical", "amount": { "mul": [0.5, { "stat": "attack", "of": "self" }] }, "target": { "from": "action_target_allies", "pick": "random", "count": 1 } }] }] }],
      "verbs": ["area", "physical_damage"] },
    { "id": "stand_guard", "class": "warrior", "name": "Stand Guard", "text": "When an ally drops below half health, taunts for 2 turns. Once per fight.",
      "rules": [{ "id": "taunt", "kind": "triggered", "when": { "on": "hp_below", "who": "ally", "below": 0.5 }, "limit": { "times": 1, "per": "fight" },
